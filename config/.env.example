# Copy to .env in the project root and fill in your own values.
# Never commit the real .env file.

TENDERTRACKER_DB_PATH=data/tenders.db
TENDERTRACKER_EXCEL_PATH=data/tenders.xlsx
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=

# Optional — cloud sync of the Excel tracker to OneDrive/SharePoint via
# Microsoft Graph. Leave blank to skip cloud sync entirely (local .xlsx
# only). Setup steps: docs/CLOUD_SYNC_SETUP.md
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_DRIVE_ID=
MS_GRAPH_UPLOAD_PATH=TenderTracker/tenders.xlsx
